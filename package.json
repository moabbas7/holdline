{
  "name": "holdline",
  "version": "0.1.0",
  "description": "Local CLI that catches what AI coding agents break outside the task they were given.",
  "type": "module",
  "bin": {
    "holdline": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "schema",
    "docs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai",
    "agent",
    "snapshot",
    "rollback",
    "git",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.8.1",
    "commander": "^14.0.3",
    "libpg-query": "18.2.2",
    "pg": "8.23.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.17.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
